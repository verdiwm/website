<section
  class="bg-forest/40 border-y-sage/15 relative z-2 border-y px-14 py-28 max-md:px-8"
>
  <div class="mx-auto max-w-275">
    <div
      class="grid grid-cols-2 items-center gap-20 max-md:grid-cols-1 max-md:gap-12"
    >
      <div>
        <p
          class="section-label text-gold reveal mb-[1.4rem] flex items-center gap-4 text-[0.6rem] tracking-[0.38em] uppercase"
        >
          II. Notation
        </p>
        <h2
          class="font-display text-paper reveal mb-12 text-[clamp(2.2rem,5vw,3.8rem)] leading-[1.05] font-black"
        >
          Your desktop,<br /><em class="text-mist">your score.</em>
        </h2>
        <div class="reveal">
          <p
            class="font-fell text-mist/60 mb-4 text-[0.95rem] leading-[1.9] italic"
          >
            Configuration is composition. A single Corn file is all it takes to
            tune every aspect of Verdi.
          </p>
          <p
            class="font-fell text-mist/60 mb-4 text-[0.95rem] leading-[1.9] italic"
          >
            No sprawling XML. No imperative scripts. Declarative, readable, and
            version-controllable, like a well-engraved manuscript.
          </p>
        </div>
      </div>
      <div class="reveal">
        <div class="code-block-wrap relative">
          <div class="border-sage/22 bg-ink/70 border px-[1.8rem] py-8">
            <code class="block font-mono text-[0.8rem] leading-[1.85]">
              <span class="tok-comment block">&#123;</span>
              <span class="block pl-4"
                ><span class="tok-key">compositor.gaps_inner</span> = <span
                  class="tok-val">8</span
                ></span
              >
              <span class="block pl-4"
                ><span class="tok-key">compositor.gaps_outer</span> = <span
                  class="tok-val">12</span
                ></span
              >
              <span class="block pl-4"
                ><span class="tok-key">compositor.border_width</span> = <span
                  class="tok-val">1</span
                ></span
              >
              <span class="block pl-4"
                ><span class="tok-key">compositor.border_color</span> = <span
                  class="tok-str">"#c9a84c"</span
                ></span
              >
              <span class="block pl-4"
                ><span class="tok-key">compositor.animations</span> = <span
                  class="tok-bool">true</span
                ></span
              >
              <span class="block">&nbsp;</span>
              <span class="block pl-4"
                ><span class="tok-key">plugins.load</span> = [</span
              >
              <span class="block pl-8"
                ><span class="tok-str">"verdi-bar"</span></span
              >
              <span class="block pl-8"
                ><span class="tok-str">"verdi-wallpaper"</span></span
              >
              <span class="block pl-4">]</span>
              <span class="block">&nbsp;</span>
              <span class="block pl-4"
                ><span class="tok-key">keybind</span> = [</span
              >
              <span class="block pl-8"
                >&#123; <span class="tok-key">mod</span> = <span class="tok-str"
                  >"super"</span
                >
                <span class="tok-key">key</span> = <span class="tok-str"
                  >"enter"</span
                >
                <span class="tok-key">exec</span> = <span class="tok-str"
                  >"foot"</span
                > &#125;</span
              >
              <span class="block pl-8"
                >&#123; <span class="tok-key">mod</span> = <span class="tok-str"
                  >"super"</span
                >
                <span class="tok-key">key</span> = <span class="tok-str"
                  >"q"</span
                >
                <span class="tok-key">exec</span> = <span class="tok-str"
                  >"verdi:close"</span
                > &#125;</span
              >
              <span class="block pl-4">]</span>
              <span class="tok-comment block">&#125;</span>
            </code>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
