<div
  id="notes-layer"
  class="pointer-events-none fixed inset-0 z-1 overflow-hidden"
>
</div>

<script>
  const syms = [
    '\u2669',
    '\u266A',
    '\u266B',
    '\u266C',
    '\u266D',
    '\u266E',
    '\u266F',
    '\uD834\uDD1E',
    '\uD834\uDD22',
  ];
  const layer = document.getElementById('notes-layer');

  function spawnNote() {
    const el = document.createElement('span');
    el.className = 'note';
    el.textContent = syms[Math.floor(Math.random() * syms.length)];
    const size = 0.8 + Math.random() * 1.2;
    const left = 3 + Math.random() * 94;
    const dur = 16 + Math.random() * 20;
    const delay = -(Math.random() * dur);
    Object.assign(el.style, {
      left: `${left}%`,
      bottom: '-3rem',
      fontSize: `${size}rem`,
      animationDuration: `${dur}s`,
      animationDelay: `${delay}s`,
    });
    layer.appendChild(el);
    setTimeout(() => el.remove(), (dur + Math.abs(delay) + 3) * 1000);
  }

  for (let i = 0; i < 22; i++) spawnNote();
  setInterval(spawnNote, 1800);
</script>
