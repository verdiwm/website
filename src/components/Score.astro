---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  class={className}
  width="100%"
  viewBox="0 0 240 52"
  xmlns="http://www.w3.org/2000/svg"
  overflow="hidden"
  display="block"
  aria-hidden="true"
>
  <!-- Five staff lines -->
  <line x1="28" y1="10" x2="234" y2="10" stroke="#a8c9ae" stroke-width="0.8"
  ></line>
  <line x1="28" y1="20" x2="234" y2="20" stroke="#a8c9ae" stroke-width="0.8"
  ></line>
  <line x1="28" y1="30" x2="234" y2="30" stroke="#a8c9ae" stroke-width="0.8"
  ></line>
  <line x1="28" y1="40" x2="234" y2="40" stroke="#a8c9ae" stroke-width="0.8"
  ></line>
  <line x1="28" y1="50" x2="234" y2="50" stroke="#a8c9ae" stroke-width="0.8"
  ></line>
  <!-- Opening bar line -->
  <line x1="28" y1="10" x2="28" y2="50" stroke="#a8c9ae" stroke-width="1"
  ></line>
  <!-- Treble clef -->
  <text
    x="1"
    y="51"
    font-size="46"
    fill="#c9a84c"
    opacity="0.7"
    font-family="serif">𝄞</text
  >
  <!-- Notes (quarter, quarter, beamed; then half note fading out) -->
  <ellipse
    cx="72"
    cy="25"
    rx="6"
    ry="4"
    transform="rotate(-15,72,25)"
    fill="#c9a84c"
    opacity="0.85"></ellipse>
  <line
    x1="77.5"
    y1="24"
    x2="77.5"
    y2="6"
    stroke="#c9a84c"
    stroke-width="1.2"
    opacity="0.85"></line>
  <ellipse
    cx="100"
    cy="15"
    rx="6"
    ry="4"
    transform="rotate(-15,100,15)"
    fill="#c9a84c"
    opacity="0.8"></ellipse>
  <line
    x1="105.5"
    y1="14"
    x2="105.5"
    y2="2"
    stroke="#c9a84c"
    stroke-width="1.2"
    opacity="0.8"></line>
  <line
    x1="77.5"
    y1="6"
    x2="105.5"
    y2="2"
    stroke="#c9a84c"
    stroke-width="2.4"
    opacity="0.75"></line>
  <ellipse
    cx="132"
    cy="30"
    rx="6"
    ry="4"
    transform="rotate(-15,132,30)"
    fill="#c9a84c"
    opacity="0.65"></ellipse>
  <line
    x1="137.5"
    y1="29"
    x2="137.5"
    y2="12"
    stroke="#c9a84c"
    stroke-width="1.2"
    opacity="0.65"></line>
  <ellipse
    cx="160"
    cy="20"
    rx="6"
    ry="4"
    transform="rotate(-15,160,20)"
    fill="#c9a84c"
    opacity="0.5"></ellipse>
  <line
    x1="165.5"
    y1="19"
    x2="165.5"
    y2="4"
    stroke="#c9a84c"
    stroke-width="1.2"
    opacity="0.5"></line>
  <!-- Half note (fading) -->
  <ellipse
    cx="190"
    cy="35"
    rx="6"
    ry="4"
    transform="rotate(-15,190,35)"
    fill="none"
    stroke="#c9a84c"
    stroke-width="1.4"
    opacity="0.38"></ellipse>
  <line
    x1="195.5"
    y1="34"
    x2="195.5"
    y2="17"
    stroke="#c9a84c"
    stroke-width="1.2"
    opacity="0.38"></line>
  <!-- Double bar -->
  <line
    x1="224"
    y1="10"
    x2="224"
    y2="50"
    stroke="#c9a84c"
    stroke-width="1"
    opacity="0.35"></line>
  <line
    x1="230"
    y1="10"
    x2="230"
    y2="50"
    stroke="#c9a84c"
    stroke-width="2.8"
    opacity="0.35"></line>
</svg>
